<h1>つぶやき一覧</h1>

<% if session[:login_uid] %>
  <p>ログイン中: <%= @current_user&.uid %></p>
  <%= link_to "マイプロフィール", user_profile_path(@current_user) %> |
  <%= link_to "ユーザ一覧", users_path %> |
  <%= link_to "ログアウト", top_logout_path %>

  <%= form_with url: tweets_path, method: :post do |f| %>
    <%= f.text_field :message, size: 50 %>
    <%= f.submit "ツイート" %>
  <% end %>
<% else %>
  <%= link_to "ログイン", top_main_path %>
<% end %>

<hr>

<% @tweets.each do |e| %>
  <div>
    <strong>
      <% if e.user %>
        <%= link_to e.user.uid, user_profile_path(e.user) %>
      <% else %>
        unknown
      <% end %>
    </strong>:
    <%= e.message %>
    <small><%= e.created_at.strftime("%m-%d %H:%M") %></small>

    <% if session[:login_uid] %>
      <%= link_to 'いいね', likes_path(tweet_id: e.id), data: { turbo_method: :post } %>
      <%= link_to 'いいね削除', like_path(e), data: { turbo_method: :delete } %>
    <% end %>

    <small>♥ <%= e.likes.count %></small>
    <%= link_to "削除", tweet_path(e), data: { turbo_method: :delete, turbo_confirm: "削除？" } %>
  </div>
<% end %>