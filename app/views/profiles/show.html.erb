# profiles\show.html.erb
<h1><%= @user.uid %> のプロフィール</h1>

<% if @profile %>
  <p><strong>メッセージ:</strong></p>
  <p><%= simple_format(@profile.message) %></p>

  <% if session[:login_uid] == @user.uid %>
    <%= link_to "編集", edit_user_profile_path(@user) %>
  <% end %>
<% else %>
  <p>プロフィール未登録</p>

  <% if session[:login_uid] == @user.uid %>
    <%= link_to "プロフィールを登録", new_user_profile_path(@user) %>
  <% end %>
<% end %>

<hr>
<%= link_to "ツイート一覧へ", tweets_path %>