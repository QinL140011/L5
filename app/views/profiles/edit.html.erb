# profiles\edit.html.erb
<h1>プロフィール編集</h1>

<% if @error %>
  <p style="color:red;"><%= @error %></p>
<% end %>

<%= form_with model: @profile, url: user_profile_path(@user), method: :patch, data: { turbo: false } do |f| %>
  <div>メッセージ: <%= f.text_area :message, rows: 5 %></div>
  <%= f.submit "更新" %>
<% end %>

<hr>
<%= link_to "プロフィールへ戻る", user_profile_path(@user) %>