# users\new.html.erb
<h1>ユーザ登録</h1>

<% if @error %>
  <p style="color:red;"><%= @error %></p>
<% end %>

<%= form_with url: users_path, method: :post, data: { turbo: false } do |f| %>
  <div>ID: <%= f.text_field :uid, value: params[:uid] %></div>
  <div>パスワード: <%= f.text_field :password %></div>
  <div>パスワード（確認）: <%= f.text_field :password_confirmation %></div>
  <div>AGE: <%= f.number_field :age, value: params[:age] %></div>
  <%= f.submit "登録" %>
<% end %>

<hr>
<%= link_to "一覧へ戻る", users_path %> | <%= link_to "ログイン画面へ", top_main_path %>