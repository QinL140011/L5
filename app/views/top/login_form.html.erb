<h1>ログイン</h1>

<% if @error %>
  <p style="color:red;"><%= @error %></p>
<% end %>

<%= form_with url: top_login_path, method: :post, data: { turbo: false } do |f| %>
  <div>ID: <%= f.text_field :uid %></div>
  <div>PASS: <%= f.password_field :pass %></div>
  <%= f.submit "ログイン" %>
<% end %>

<hr>
<%= link_to "ユーザ登録", new_user_path %> |
<%= link_to "ツイート一覧", tweets_path %> |
<%= link_to "ユーザ一覧", users_path %>